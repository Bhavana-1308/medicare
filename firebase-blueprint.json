{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Represents an authenticated user (Patient or Caregiver) in MediCare.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique Firebase Auth UID" },
        "name": { "type": "string", "maxLength": 100, "description": "Full name of the user" },
        "email": { "type": "string", "maxLength": 150, "description": "Registered email address" },
        "photoURL": { "type": "string", "maxLength": 500, "description": "Profile picture avatar URL" },
        "role": { "type": "string", "enum": ["patient", "caregiver"], "description": "System role" },
        "linkedPatients": { "type": "array", "description": "List of linked patient emails or UIDs" },
        "linkedCaregivers": { "type": "array", "description": "List of linked caregiver emails or UIDs" },
        "createdAt": { "type": "string", "format": "date-time" },
        "notificationSettings": { "type": "object" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "Medicine": {
      "title": "Medicine",
      "description": "Medicine prescription and stock tracking item.",
      "type": "object",
      "properties": {
        "medicineId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "description": "Owner Patient UID" },
        "name": { "type": "string", "maxLength": 100 },
        "dosage": { "type": "string", "maxLength": 50 },
        "frequency": { "type": "string", "maxLength": 50 },
        "times": { "type": "array", "description": "Array of scheduled HH:mm times" },
        "startDate": { "type": "string", "maxLength": 20 },
        "endDate": { "type": "string", "maxLength": 20 },
        "stock": { "type": "number", "description": "Current quantity in stock" },
        "lowStockLimit": { "type": "number", "description": "Threshold for low stock warnings" },
        "expiryDate": { "type": "string", "maxLength": 20 },
        "notes": { "type": "string", "maxLength": 500 },
        "form": { "type": "string", "maxLength": 30 },
        "instructions": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["medicineId", "userId", "name", "dosage", "frequency", "times", "stock", "lowStockLimit", "expiryDate"]
    },
    "DoseLog": {
      "title": "DoseLog",
      "description": "Log entry recording whether a specific dose was taken, skipped, or missed.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "medicineId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "medicineName": { "type": "string", "maxLength": 100 },
        "dosage": { "type": "string", "maxLength": 50 },
        "userId": { "type": "string" },
        "date": { "type": "string", "maxLength": 20 },
        "time": { "type": "string", "maxLength": 10 },
        "status": { "type": "string", "enum": ["taken", "skipped", "missed", "upcoming"] },
        "loggedAt": { "type": "string", "format": "date-time" },
        "stockDeducted": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "medicineId", "userId", "date", "time", "status", "loggedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles containing role, permissions, and linked caregiver/patient mappings."
    },
    "/medicines/{medicineId}": {
      "schema": "Medicine",
      "description": "Prescription and stock inventory items managed by patients and viewed by linked caregivers."
    },
    "/doseLogs/{logId}": {
      "schema": "DoseLog",
      "description": "Medication compliance and dose status records for adherence calculation."
    }
  }
}
